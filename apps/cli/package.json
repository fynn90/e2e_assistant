{
  "name": "@charlie_deng/e2e-assistant-cli",
  "version": "0.3.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "e2e_assistant": "./dist/index.js",
    "authine-e2e-agent": "./dist/index.js"
  },
  "scripts": {
    "dev": "node ../../scripts/dev-cli-watch.mjs",
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=15000",
    "test:unit": "vitest run --testTimeout=15000",
    "prepack": "pnpm run build",
    "start": "node dist/index.js start"
  },
  "dependencies": {
    "@charlie_deng/e2e-assistant-config": "workspace:^",
    "@charlie_deng/e2e-assistant-service": "workspace:^",
    "@charlie_deng/e2e-assistant-types": "workspace:^",
    "@charlie_deng/e2e-assistant-web-host": "workspace:^",
    "@earendil-works/pi-tui": "^0.78.0",
    "cac": "^7.0.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}