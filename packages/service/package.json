{
  "name": "@charlie_deng/e2e-assistant-service",
  "version": "0.2.3",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm && tsc --ignoreConfig src/index.ts --declaration --emitDeclarationOnly --outDir dist --module ESNext --target ES2022 --moduleResolution Bundler --ignoreDeprecations 6.0 --skipLibCheck --types node",
    "dev": "tsup src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=15000",
    "test:unit": "vitest run --testTimeout=15000",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@charlie_deng/e2e-assistant-agent": "workspace:^",
    "@charlie_deng/e2e-assistant-config": "workspace:^",
    "@charlie_deng/e2e-assistant-playwright-engine": "workspace:^",
    "@charlie_deng/e2e-assistant-skill-manager": "workspace:^",
    "@charlie_deng/e2e-assistant-types": "workspace:^",
    "@hono/node-server": "^2.0.4",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
