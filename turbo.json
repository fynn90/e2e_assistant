{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["AUTHINE_CLI_PORT", "AUTHINE_WEB_PORT", "USERNAME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
